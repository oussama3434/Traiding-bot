class FakeBreakoutDetector:

    def __init__(self, df, lookback=10):
        self.df = df
        self.lookback = lookback

    # ==========================================
    # أعلى وأدنى مستوى سابق
    # ==========================================

    def previous_high(self, index):

        if index < self.lookback:
            return None

        return self.df.iloc[
            index-self.lookback:index
        ]["high"].max()

    def previous_low(self, index):

        if index < self.lookback:
            return None

        return self.df.iloc[
            index-self.lookback:index
        ]["low"].min()

    # ==========================================
    # كسر كاذب للأعلى
    # ==========================================

    def fake_breakout_up(self, index):

        high = self.previous_high(index)

        if high is None:
            return False

        candle = self.df.iloc[index]

        return (
            candle["high"] > high and
            candle["close"] < high
        )

    # ==========================================
    # كسر كاذب للأسفل
    # ==========================================

    def fake_breakout_down(self, index):

        low = self.previous_low(index)

        if low is None:
            return False

        candle = self.df.iloc[index]

        return (
            candle["low"] < low and
            candle["close"] > low
        )

    # ==========================================
    # نوع الكسر
    # ==========================================

    def breakout_type(self, index):

        if self.fake_breakout_up(index):
            return "SELL"

        if self.fake_breakout_down(index):
            return "BUY"

        return None

    # ==========================================
    # درجة قوة الكسر الكاذب
    # ==========================================

    def strength(self, index):

        signal = self.breakout_type(index)

        if signal is None:
            return 0

        candle = self.df.iloc[index]

        body = abs(
            candle["close"] - candle["open"]
        )

        full = candle["high"] - candle["low"]

        if full == 0:
            return 0

        rejection = 1 - (body / full)

        score = round(rejection * 100, 2)

        return min(score, 100)

    # ==========================================
    # التحليل النهائي
    # ==========================================

    def analyze(self, index):

        return {

            "fake_breakout_up":
                self.fake_breakout_up(index),

            "fake_breakout_down":
                self.fake_breakout_down(index),

            "signal":
                self.breakout_type(index),

            "strength":
                self.strength(index)

        }

