from datetime import datetime


class SignalManager:


    def __init__(self, filters):

        self.filters = filters

        self.last_signals = {}



    # ==========================================
    # منع تكرار الإشارة
    # ==========================================

    def duplicate_signal(
        self,
        pair,
        direction
    ):

        key = f"{pair}_{direction}"


        if key in self.last_signals:

            return True


        return False



    # ==========================================
    # حفظ الإشارة
    # ==========================================

    def save_signal(
        self,
        pair,
        direction
    ):

        key = f"{pair}_{direction}"


        self.last_signals[key] = {

            "time":
                datetime.now(),

            "direction":
                direction

        }


        self.filters.register_signal()



    # ==========================================
    # إنشاء الإشارة النهائية
    # ==========================================

    def create_signal(
        self,
        pair,
        analysis
    ):


        if not analysis:

            return None



        direction = analysis.get(
            "signal"
        )


        if not direction:

            return None



        if self.duplicate_signal(
            pair,
            direction
        ):

            return None



        if not self.filters.allow_new_signal():

            return None



        self.save_signal(
            pair,
            direction
        )



        return {

            "pair":
                pair,

            "direction":
                direction,

            "score":
                analysis.get(
                    "score",
                    0
                ),

            "reason":
                analysis.get(
                    "reason",
                    ""
                ),

            "time":
                datetime.now().strftime(
                    "%H:%M"
                )

        }



    # ==========================================
    # تنظيف الإشارات القديمة
    # ==========================================

    def clear_old_signals(self):

        now = datetime.now()


        remove = []


        for key, data in self.last_signals.items():

            diff = (
                now - data["time"]
            ).seconds


            # حذف بعد ساعة

            if diff > 3600:

                remove.append(key)



        for key in remove:

            del self.last_signals[key]
