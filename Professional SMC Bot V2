import numpy as np


class ConsolidationDetector:

    def __init__(self, df, lookback=8):
        self.df = df
        self.lookback = lookback

    # ==========================================
    # حساب نطاق الحركة
    # ==========================================

    def get_range(self, candles):

        highest = candles["high"].max()
        lowest = candles["low"].min()

        return highest - lowest

    # ==========================================
    # متوسط حجم الشموع
    # ==========================================

    def average_body(self, candles):

        bodies = abs(candles["close"] - candles["open"])

        return np.mean(bodies)

    # ==========================================
    # كشف التجميع
    # ==========================================

    def is_consolidation(self):

        if len(self.df) < self.lookback:
            return False

        candles = self.df.tail(self.lookback)

        total_range = self.get_range(candles)

        avg_body = self.average_body(candles)

        # إذا كان النطاق ضيقاً مقارنة بمتوسط جسم الشموع
        if total_range <= avg_body * 4:
            return True

        return False

    # ==========================================
    # قوة التجميع
    # ==========================================

    def consolidation_strength(self):

        if not self.is_consolidation():
            return 0

        candles = self.df.tail(self.lookback)

        total_range = self.get_range(candles)

        avg_body = self.average_body(candles)

        if avg_body == 0:
            return 100

        strength = (1 - (total_range / (avg_body * 4))) * 100

        strength = max(0, min(100, strength))

        return round(strength, 2)

    # ==========================================
    # التحليل النهائي
    # ==========================================

    def analyze(self):

        return {
            "is_consolidation": self.is_consolidation(),
            "strength": self.consolidation_strength()
        }
