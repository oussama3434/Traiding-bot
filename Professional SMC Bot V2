class SmartMoneyConcepts:

    def __init__(self, df):
        self.df = df

    # ==========================================
    # Break Of Structure (BOS)
    # ==========================================

    def detect_bos(self, index):

        if index < 5:
            return None

        current = self.df.iloc[index]

        previous_high = self.df.iloc[index-5:index]["high"].max()
        previous_low = self.df.iloc[index-5:index]["low"].min()

        if current["close"] > previous_high:
            return "BULLISH"

        if current["close"] < previous_low:
            return "BEARISH"

        return None

    # ==========================================
    # Change Of Character (CHOCH)
    # ==========================================

    def detect_choch(self, index):

        if index < 10:
            return None

        bos_now = self.detect_bos(index)
        bos_prev = self.detect_bos(index - 1)

        if bos_now != bos_prev:
            return bos_now

        return None

    # ==========================================
    # Fair Value Gap (FVG)
    # ==========================================

    def detect_fvg(self, index):

        if index < 2:
            return None

        c1 = self.df.iloc[index - 2]
        c2 = self.df.iloc[index - 1]
        c3 = self.df.iloc[index]

        # Bullish FVG
        if c1["high"] < c3["low"]:

            return {
                "type": "BUY",
                "high": c3["low"],
                "low": c1["high"]
            }

        # Bearish FVG
        if c1["low"] > c3["high"]:

            return {
                "type": "SELL",
                "high": c1["low"],
                "low": c3["high"]
            }

        return None

    # ==========================================
    # Liquidity Sweep
    # ==========================================

    def detect_liquidity_sweep(self, index):

        if index < 5:
            return None

        current = self.df.iloc[index]

        previous_high = self.df.iloc[index-5:index]["high"].max()
        previous_low = self.df.iloc[index-5:index]["low"].min()

        # أخذ سيولة القمم
        if (
            current["high"] > previous_high and
            current["close"] < previous_high
        ):
            return "SELL"

        # أخذ سيولة القيعان
        if (
            current["low"] < previous_low and
            current["close"] > previous_low
        ):
            return "BUY"

        return None

    # ==========================================
    # Order Block
    # ==========================================

    def detect_order_block(self, index):

        if index < 2:
            return None

        candle = self.df.iloc[index]

        if candle["close"] > candle["open"]:

            return {
                "type": "BUY",
                "high": candle["high"],
                "low": candle["low"]
            }

        if candle["close"] < candle["open"]:

            return {
                "type": "SELL",
                "high": candle["high"],
                "low": candle["low"]
            }

        return None

    # ==========================================
    # Full Analysis
    # ==========================================

    def analyze(self, index):

        return {

            "bos": self.detect_bos(index),

            "choch": self.detect_choch(index),

            "fvg": self.detect_fvg(index),

            "liquidity": self.detect_liquidity_sweep(index),

            "order_block": self.detect_order_block(index)

        }
