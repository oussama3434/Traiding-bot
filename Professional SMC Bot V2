import pandas as pd

from config import MIN_ZONE_SCORE


class ZoneDetector:

    def __init__(self, df):
        self.df = df

    def is_demand_zone(self, index):

        if index < 2:
            return False

        c1 = self.df.iloc[index - 2]
        c2 = self.df.iloc[index - 1]
        c3 = self.df.iloc[index]

        return (
            c1["close"] < c1["open"] and
            c2["close"] < c2["open"] and
            c3["close"] > c3["open"] and
            c3["close"] > c2["high"]
        )

    def is_supply_zone(self, index):

        if index < 2:
            return False

        c1 = self.df.iloc[index - 2]
        c2 = self.df.iloc[index - 1]
        c3 = self.df.iloc[index]

        return (
            c1["close"] > c1["open"] and
            c2["close"] > c2["open"] and
            c3["close"] < c3["open"] and
            c3["close"] < c2["low"]
        )

    def calculate_score(self, zone):

        score = 0

        score += 30      # تكوين المنطقة
        score += 20      # الزخم
        score += 20      # حجم الكسر
        score += 15      # نظافة الحركة
        score += 15      # عدم إعادة الاختبار

        return score

    def detect(self):

        zones = []

        for i in range(2, len(self.df) - 1):

            if self.is_demand_zone(i):

                zone = {
                    "type": "BUY",
                    "high": self.df.iloc[i]["high"],
                    "low": self.df.iloc[i]["low"],
                    "index": i
                }

                zone["score"] = self.calculate_score(zone)

                if zone["score"] >= MIN_ZONE_SCORE:
                    zones.append(zone)

            elif self.is_supply_zone(i):

                zone = {
                    "type": "SELL",
                    "high": self.df.iloc[i]["high"],
                    "low": self.df.iloc[i]["low"],
                    "index": i
                }

                zone["score"] = self.calculate_score(zone)

                if zone["score"] >= MIN_ZONE_SCORE:
                    zones.append(zone)

        return sorted(
            zones,
            key=lambda x: x["score"],
            reverse=True
        )
