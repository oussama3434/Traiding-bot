class PriceAction:

    def __init__(self, df):
        self.df = df

    def body_size(self, candle):
        return abs(candle["close"] - candle["open"])

    def upper_wick(self, candle):
        return candle["high"] - max(candle["open"], candle["close"])

    def lower_wick(self, candle):
        return min(candle["open"], candle["close"]) - candle["low"]

    def is_bullish_pinbar(self, candle):

        body = self.body_size(candle)
        lower = self.lower_wick(candle)
        upper = self.upper_wick(candle)

        return (
            lower > body * 2 and
            upper < body
        )

    def is_bearish_pinbar(self, candle):

        body = self.body_size(candle)
        upper = self.upper_wick(candle)
        lower = self.lower_wick(candle)

        return (
            upper > body * 2 and
            lower < body
        )

    def bullish_engulfing(self, index):

        if index == 0:
            return False

        prev = self.df.iloc[index - 1]
        curr = self.df.iloc[index]

        return (
            prev["close"] < prev["open"] and
            curr["close"] > curr["open"] and
            curr["open"] <= prev["close"] and
            curr["close"] >= prev["open"]
        )

    def bearish_engulfing(self, index):

        if index == 0:
            return False

        prev = self.df.iloc[index - 1]
        curr = self.df.iloc[index]

        return (
            prev["close"] > prev["open"] and
            curr["close"] < curr["open"] and
            curr["open"] >= prev["close"] and
            curr["close"] <= prev["open"]
        )

    def strong_bullish_candle(self, candle):

        body = self.body_size(candle)

        return (
            candle["close"] > candle["open"] and
            body > (candle["high"] - candle["low"]) * 0.70
        )

    def strong_bearish_candle(self, candle):

        body = self.body_size(candle)

        return (
            candle["close"] < candle["open"] and
            body > (candle["high"] - candle["low"]) * 0.70
        )

    def analyze(self, index):

        candle = self.df.iloc[index]

        result = {
            "bullish_pinbar": self.is_bullish_pinbar(candle),
            "bearish_pinbar": self.is_bearish_pinbar(candle),
            "bullish_engulfing": self.bullish_engulfing(index),
            "bearish_engulfing": self.bearish_engulfing(index),
            "strong_bullish": self.strong_bullish_candle(candle),
            "strong_bearish": self.strong_bearish_candle(candle)
        }

        return result
