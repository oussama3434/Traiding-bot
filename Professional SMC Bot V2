from config import (
    STRONG_CANDLE_BODY_RATIO,
    PINBAR_WICK_RATIO,
    PINBAR_BODY_RATIO
)


class PriceAction:

    def __init__(self, df):
        self.df = df

    # ==========================================
    # حجم جسم الشمعة
    # ==========================================
    def body_size(self, candle):
        return abs(candle["close"] - candle["open"])

    # ==========================================
    # الذيل العلوي
    # ==========================================
    def upper_wick(self, candle):
        return candle["high"] - max(candle["open"], candle["close"])

    # ==========================================
    # الذيل السفلي
    # ==========================================
    def lower_wick(self, candle):
        return min(candle["open"], candle["close"]) - candle["low"]

    # ==========================================
    # طول الشمعة بالكامل
    # ==========================================
    def candle_range(self, candle):
        return candle["high"] - candle["low"]

    # ==========================================
    # Bullish Pin Bar
    # ==========================================
    def is_bullish_pinbar(self, candle):

        full = self.candle_range(candle)

        if full <= 0:
            return False

        body = self.body_size(candle)
        lower = self.lower_wick(candle)
        upper = self.upper_wick(candle)

        return (
            lower >= full * PINBAR_WICK_RATIO and
            body <= full * PINBAR_BODY_RATIO and
            upper <= body
        )

    # ==========================================
    # Bearish Pin Bar
    # ==========================================
    def is_bearish_pinbar(self, candle):

        full = self.candle_range(candle)

        if full <= 0:
            return False

        body = self.body_size(candle)
        upper = self.upper_wick(candle)
        lower = self.lower_wick(candle)

        return (
            upper >= full * PINBAR_WICK_RATIO and
            body <= full * PINBAR_BODY_RATIO and
            lower <= body
        )

    # ==========================================
    # Bullish Engulfing
    # ==========================================
    def bullish_engulfing(self, index):

        if index <= 0 or index >= len(self.df):
            return False

        prev = self.df.iloc[index - 1]
        curr = self.df.iloc[index]

        if self.body_size(prev) == 0:
            return False

        return (
            prev["close"] < prev["open"] and
            curr["close"] > curr["open"] and
            curr["open"] <= prev["close"] and
            curr["close"] >= prev["open"]
        )

    # ==========================================
    # Bearish Engulfing
