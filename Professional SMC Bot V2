class RiskManager:


    def __init__(
        self,
        minimum_score=70,
        max_daily_signals=15
    ):

        self.minimum_score = minimum_score

        self.max_daily_signals = max_daily_signals

        self.daily_signals = 0



    # ==========================================
    # فحص قوة الإشارة
    # ==========================================

    def check_signal_quality(
        self,
        signal
    ):


        if not signal:

            return False



        score = signal.get(
            "score",
            0
        )


        if score < self.minimum_score:

            return False



        return True



    # ==========================================
    # منع كثرة الإشارات
    # ==========================================

    def allow_signal(self):


        if (
            self.daily_signals
            >=
            self.max_daily_signals
        ):

            return False



        return True



    # ==========================================
    # تسجيل إشارة
    # ==========================================

    def register_signal(self):

        self.daily_signals += 1



    # ==========================================
    # إعادة العداد
