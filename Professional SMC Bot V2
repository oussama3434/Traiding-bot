import pandas as pd


class Indicators:

    def __init__(self, df):
        self.df = df.copy()

    # ==========================================
    # EMA
    # ==========================================

    def ema(self, period):

        return self.df["close"].ewm(
            span=period,
            adjust=False
        ).mean()

    def ema_trend(self):

        ema20 = self.ema(20)
        ema50 = self.ema(50)

        if ema20.iloc[-1] > ema50.iloc[-1]:
            return "BUY"

        if ema20.iloc[-1] < ema50.iloc[-1]:
            return "SELL"

        return None

    # ==========================================
    # RSI
    # ==========================================

    def rsi(self, period=14):

        delta = self.df["close"].diff()

        gain = delta.clip(lower=0)

        loss = -delta.clip(upper=0)

        avg_gain = gain.rolling(period).mean()

        avg_loss = loss.rolling(period).mean()

        rs = avg_gain / avg_loss

        rsi = 100 - (100 / (1 + rs))

        return rsi

    def rsi_signal(self):

        value = self.rsi().iloc[-1]

        if value <= 30:
            return "BUY"

        if value >= 70:
            return "SELL"

        return None

    # ==========================================
    # MACD
    # ==========================================

    def macd(self):

        ema12 = self.df["close"].ewm(
            span=12,
            adjust=False
        ).mean()

        ema26 = self.df["close"].ewm(
            span=26,
            adjust=False
        ).mean()

        macd = ema12 - ema26

        signal = macd.ewm(
            span=9,
            adjust=False
        ).mean()

        histogram = macd - signal

        return macd, signal, histogram

    def macd_signal(self):

        macd, signal, hist = self.macd()

        if (
            hist.iloc[-2] < 0 and
            hist.iloc[-1] > 0
        ):
            return "BUY"

        if (
            hist.iloc[-2] > 0 and
            hist.iloc[-1] < 0
        ):
            return "SELL"

        return None

    # ==========================================
    # Final Confirmation
    # ==========================================

    def confirmation(self):

        return {

            "ema": self.ema_trend(),

            "rsi": self.rsi_signal(),

            "macd": self.macd_signal()

        }
