    def bearish_engulfing(self, index):

        if index <= 0 or index >= len(self.df):
            return False

        prev = self.df.iloc[index - 1]
        curr = self.df.iloc[index]

        if self.body_size(prev) == 0:
            return False

        return (
            prev["close"] > prev["open"] and
            curr["close"] < curr["open"] and
            curr["open"] >= prev["close"] and
            curr["close"] <= prev["open"]
        )

    # ==========================================
    # شمعة صاعدة قوية
    # ==========================================
    def strong_bullish_candle(self, candle):

        full = self.candle_range(candle)

        if full <= 0:
            return False

        body = self.body_size(candle)

        return (
            candle["close"] > candle["open"] and
            body >= full * STRONG_CANDLE_BODY_RATIO
        )

    # ==========================================
    # شمعة هابطة قوية
    # ==========================================
    def strong_bearish_candle(self, candle):

        full = self.candle_range(candle)

        if full <= 0:
            return False

        body = self.body_size(candle)

        return (
            candle["close"] < candle["open"] and
            body >= full * STRONG_CANDLE_BODY_RATIO
        )

    # ==========================================
    # التحليل النهائي
    # ==========================================
    def analyze(self, index):

        if index < 0 or index >= len(self.df):
            return None

        candle = self.df.iloc[index]

