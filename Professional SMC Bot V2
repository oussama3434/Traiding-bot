import requests

from config import BOT_TOKEN, CHANNEL_ID


class TelegramBot:

    def __init__(self):
        self.token = BOT_TOKEN
        self.channel = CHANNEL_ID

    def send(self, message):

        if not self.token or not self.channel:
            print("[Telegram] BOT_TOKEN أو CHANNEL_ID غير موجود.")
            return False

        url = (
            f"https://api.telegram.org/bot"
            f"{self.token}/sendMessage"
        )

        payload = {
            "chat_id": self.channel,
            "text": message,
            "parse_mode": "HTML"
        }

        try:

            response = requests.post(
                url,
                data=payload,
                timeout=10
            )

            if response.status_code == 200:
                return True

            print(response.text)
            return False

        except Exception as e:
            print(f"[Telegram] {e}")
            return False

    def signal(
        self,
        pair,
        direction,
        confidence,
        timeframe="5M"
    ):

        message = (
            "📊 <b>Professional SMC Bot V2</b>\n\n"
            f"💱 الزوج : {pair}\n"
            f"📈 الاتجاه : {direction}\n"
            f"⏱ الفريم : {timeframe}\n"
            f"🎯 الثقة : {confidence}%"
        )

        return self.send(message)

    def info(self, text):
        return self.send(text)
