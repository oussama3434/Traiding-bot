import datetime
import pytz
from config import START_HOUR, END_HOUR, TIMEZONE

class TimeFilter:


    def __init__(
        self,
        start_hour=START_HOUR,
        end_hour=END_HOUR,
        timezone=TIMEZONE
):

        self.start_hour = start_hour
        self.end_hour = end_hour

        self.timezone = pytz.timezone(
            timezone
        )


    # ==========================================
    # الوقت الحالي
    # ==========================================

    def now(self):

        return datetime.datetime.now(
            self.timezone
        )


    # ==========================================
    # يوم العمل
    # ==========================================

    def is_work_day(self):

        current = self.now()

        # الاثنين = 0
        # الجمعة = 4

        return current.weekday() in [
            0,
            1,
            2,
            3,
            4
        ]


    # ==========================================
    # ساعات التداول
    # ==========================================

    def is_trading_time(self):

        current = self.now()

        hour = current.hour


        return (
            hour >= self.start_hour
            and
            hour < self.end_hour
        )


    # ==========================================
    # الفلتر النهائي
    # ==========================================

    def allowed(self):

        if not self.is_work_day():

            return False


        if not self.is_trading_time():

            return False


        return True


    # ==========================================
    # حالة الفلتر
    # ==========================================

    def status(self):

        if not self.is_work_day():

            return "Weekend"


        if not self.is_trading_time():

            return "Outside Trading Hours"


        return "ACTIVE"
