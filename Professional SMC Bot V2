from strategy.rejection import RejectionDetector
from strategy.consolidation import ConsolidationDetector
from strategy.fake_breakout import FakeBreakoutDetector

from indicators import Indicators


class SMCStrategy:

    def __init__(self, df5, df1):

        self.df5 = df5
        self.df1 = df1

        self.index = len(df5) - 1

        self.zones = ZoneDetector(df5)

        self.price = PriceAction(df5)

        self.smc = SmartMoneyConcepts(df5)

        self.rejection = RejectionDetector(df5)

        self.consolidation = ConsolidationDetector(df5)

        self.fake_breakout = FakeBreakoutDetector(df5)

        self.indicators = Indicators(df5)


    # ==========================================
    # حساب قوة الإشارة
    # ==========================================

    def calculate_confidence(
        self,
        zone,
        smc,
        rejection,
        fake,
        indicators
    ):

        score = 0


        # قوة المنطقة
        if zone:
            score += zone["score"] * 0.35


        # Rejection
        if rejection["signal"]:
            score += 20


        # Liquidity Sweep
        if smc["liquidity"]:
            score += 15


        # FVG
        if smc["fvg"]:
            score += 10


        # Fake breakout
        if fake["signal"]:
            score += 10


        # Confirmation indicators
        if indicators["ema"]:
            score += 5


        confidence = int(min(score,100))


        return confidence



    # ==========================================
    # تشغيل التحليل
    # ==========================================

    def run(self):


        # منع الدخول أثناء التجميع

        consolidation = self.consolidation.analyze()

        if consolidation["is_consolidation"]:
            return None



        # أفضل منطقة

        zones = self.zones.detect()


        if not zones:
            return None


        zone = zones[0]



        # التحليلات

        smc = self.smc.analyze(
            self.index
        )


        rejection = self.rejection.analyze(
            self.index
        )


        fake = self.fake_breakout.analyze(
            self.index
        )


        indicators = self.indicators.confirmation()



        direction = None



        # ===============================
        # شروط BUY
        # ===============================

        if zone["type"] == "BUY":

            if rejection["signal"] == "BUY":

                if (
                    smc["liquidity"] == "BUY"
                    or smc["bos"] == "BULLISH"
                    or fake["signal"] == "BUY"
                ):

                    direction = "BUY"



        # ===============================
        # شروط SELL
        # ===============================

        if zone["type"] == "SELL":

            if rejection["signal"] == "SELL":

                if (
                    smc["liquidity"] == "SELL"
                    or smc["bos"] == "BEARISH"
                    or fake["signal"] == "SELL"
                ):

                    direction = "SELL"



        if direction is None:
            return None



        confidence = self.calculate_confidence(
            zone,
            smc,
            rejection,
            fake,
            indicators
        )


        # الحد الأدنى للجودة

        if confidence < 80:
            return None



        return {

            "direction": direction,

            "confidence": confidence,

            "zone_score": zone["score"],

            "smc": smc,

            "rejection": rejection

        }
